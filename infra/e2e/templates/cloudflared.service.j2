[Unit]
Description=Package Broker ephemeral public tunnel
After=network-online.target pb-e2e.service
Wants=network-online.target pb-e2e.service

[Service]
DynamicUser=yes
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8787 --metrics 127.0.0.1:49312
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
