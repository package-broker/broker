{
  "name": "package-broker-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @package-broker/ui run build",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "rehearsal": "pnpm build && pnpm bundle && vitest run --project runtime-node --project runtime-cloudflare src/restore-rehearsal",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "pb": "node packages/cli/dist/bin.js",
    "openapi:sync": "pnpm pb openapi --out packages/ui/openapi.json && node scripts/sync-openapi-document.mjs && pnpm --filter @package-broker/ui run gen:api && prettier --write packages/ui/src/api-types.ts",
    "bundle": "pnpm pb build --config broker.config.ts --target cloudflare && pnpm pb build --config broker.config.ts --target node",
    "check:pack": "node scripts/check-pack.mjs",
    "check:ui-assets-install": "node scripts/check-ui-assets-install.mjs",
    "check:treeshake": "node scripts/check-treeshake.mjs",
    "client-matrix": "node scripts/client-matrix.mjs",
    "smoke:cloudflare": "pnpm --filter @package-broker/runtime-cloudflare exec node scripts/worker-smoke.mjs",
    "smoke:node": "node scripts/node-bundle-smoke.mjs",
    "smoke:docker": "node scripts/docker-smoke.mjs",
    "bench:install": "node scripts/bench-install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@package-broker/cli": "workspace:^",
    "@package-broker/core": "workspace:^",
    "@package-broker/db-sqlite": "workspace:^",
    "@package-broker/plugin-github": "workspace:^",
    "@package-broker/plugin-sso-oidc": "workspace:^",
    "@package-broker/runtime-cloudflare": "workspace:^",
    "@package-broker/runtime-node": "workspace:^",
    "@package-broker/ui-assets": "workspace:^",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
