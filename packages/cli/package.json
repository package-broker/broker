{
  "name": "@package-broker/cli",
  "version": "2.0.0-rc.1",
  "description": "Package Broker CLI (pb)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "pb": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@package-broker/core": "workspace:^",
    "@package-broker/db-sqlite": "workspace:^",
    "@package-broker/runtime-cloudflare": "workspace:^",
    "@package-broker/runtime-node": "workspace:^",
    "esbuild": "catalog:"
  }
}
