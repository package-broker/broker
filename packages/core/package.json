{
  "name": "@package-broker/core",
  "version": "2.0.0-rc.0",
  "description": "Package Broker kernel: plugin and config API",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./db/*": {
      "types": "./dist/db/*.d.ts",
      "default": "./dist/db/*.js"
    },
    "./secrets/*": {
      "types": "./dist/secrets/*.d.ts",
      "default": "./dist/secrets/*.js"
    },
    "./kernel/*": {
      "types": "./dist/kernel/*.d.ts",
      "default": "./dist/kernel/*.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "default": "./dist/ids.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "hono": "catalog:"
  }
}
