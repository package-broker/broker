{
  "name": "@package-broker/core",
  "version": "2.0.0-rc.0",
  "description": "Package Broker kernel: plugin and config API",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./auth/*": {
      "types": "./dist/auth/*.d.ts",
      "default": "./dist/auth/*.js"
    },
    "./db/*": {
      "types": "./dist/db/*.d.ts",
      "default": "./dist/db/*.js"
    },
    "./platform/*": {
      "types": "./dist/platform/*.d.ts",
      "default": "./dist/platform/*.js"
    },
    "./ingest/*": {
      "types": "./dist/ingest/*.d.ts",
      "default": "./dist/ingest/*.js"
    },
    "./secrets/*": {
      "types": "./dist/secrets/*.d.ts",
      "default": "./dist/secrets/*.js"
    },
    "./kernel/*": {
      "types": "./dist/kernel/*.d.ts",
      "default": "./dist/kernel/*.js"
    },
    "./identity/*": {
      "types": "./dist/identity/*.d.ts",
      "default": "./dist/identity/*.js"
    },
    "./catalogue/*": {
      "types": "./dist/catalogue/*.d.ts",
      "default": "./dist/catalogue/*.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "default": "./dist/ids.js"
    },
    "./package.json": "./package.json",
    "./authz/*": {
      "types": "./dist/authz/*.d.ts",
      "default": "./dist/authz/*.js"
    },
    "./sources/*": {
      "types": "./dist/sources/*.d.ts",
      "default": "./dist/sources/*.js"
    },
    "./import/*": {
      "types": "./dist/import/*.d.ts",
      "default": "./dist/import/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "default": "./dist/api/*.js"
    },
    "./registry/*": {
      "types": "./dist/registry/*.d.ts",
      "default": "./dist/registry/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "hono": "catalog:",
    "zod": "catalog:"
  }
}
