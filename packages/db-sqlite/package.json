{
  "name": "@package-broker/db-sqlite",
  "version": "2.0.0-rc.0",
  "description": "Package Broker SQLite data layer",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "default": "./dist/kysely.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./sql/scan": {
      "types": "./dist/sql/scan.d.ts",
      "default": "./dist/sql/scan.js"
    },
    "./migrations/split": {
      "types": "./dist/migrations/split.d.ts",
      "default": "./dist/migrations/split.js"
    },
    "./migrations/source": {
      "types": "./dist/migrations/source.d.ts",
      "default": "./dist/migrations/source.js"
    },
    "./migrations/plan": {
      "types": "./dist/migrations/plan.d.ts",
      "default": "./dist/migrations/plan.js"
    },
    "./migrations/lock": {
      "types": "./dist/migrations/lock.d.ts",
      "default": "./dist/migrations/lock.js"
    },
    "./migrations/runner": {
      "types": "./dist/migrations/runner.d.ts",
      "default": "./dist/migrations/runner.js"
    },
    "./repositories/*": {
      "types": "./dist/repositories/*.d.ts",
      "default": "./dist/repositories/*.js"
    },
    "./contract/auth-contract": {
      "types": "./dist/contract/auth-contract.d.ts",
      "default": "./dist/contract/auth-contract.js"
    },
    "./contract/blob-contract": {
      "types": "./dist/contract/blob-contract.d.ts",
      "default": "./dist/contract/blob-contract.js"
    },
    "./contract/cache-contract": {
      "types": "./dist/contract/cache-contract.d.ts",
      "default": "./dist/contract/cache-contract.js"
    },
    "./contract/catalogue-read-contract": {
      "types": "./dist/contract/catalogue-read-contract.d.ts",
      "default": "./dist/contract/catalogue-read-contract.js"
    },
    "./contract/count-calls": {
      "types": "./dist/contract/count-calls.d.ts",
      "default": "./dist/contract/count-calls.js"
    },
    "./contract/executor-contract": {
      "types": "./dist/contract/executor-contract.d.ts",
      "default": "./dist/contract/executor-contract.js"
    },
    "./contract/job-contract": {
      "types": "./dist/contract/job-contract.d.ts",
      "default": "./dist/contract/job-contract.js"
    },
    "./contract/migration-contract": {
      "types": "./dist/contract/migration-contract.d.ts",
      "default": "./dist/contract/migration-contract.js"
    },
    "./contract/migration-lock-contract": {
      "types": "./dist/contract/migration-lock-contract.d.ts",
      "default": "./dist/contract/migration-lock-contract.js"
    },
    "./contract/observability-contract": {
      "types": "./dist/contract/observability-contract.d.ts",
      "default": "./dist/contract/observability-contract.js"
    },
    "./contract/service-principal-contract": {
      "types": "./dist/contract/service-principal-contract.d.ts",
      "default": "./dist/contract/service-principal-contract.js"
    },
    "./contract/token-contract": {
      "types": "./dist/contract/token-contract.d.ts",
      "default": "./dist/contract/token-contract.js"
    },
    "./contract/two-organizations": {
      "types": "./dist/contract/two-organizations.d.ts",
      "default": "./dist/contract/two-organizations.js"
    },
    "./testing/migrated-database": {
      "types": "./dist/testing/migrated-database.d.ts",
      "default": "./dist/testing/migrated-database.js"
    },
    "./testing/node-sqlite-executor": {
      "types": "./dist/testing/node-sqlite-executor.d.ts",
      "default": "./dist/testing/node-sqlite-executor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@package-broker/core": "workspace:^",
    "kysely": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
