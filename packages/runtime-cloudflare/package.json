{
  "name": "@package-broker/runtime-cloudflare",
  "version": "2.0.0-rc.2",
  "description": "Package Broker Cloudflare Workers runtime",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "default": "./dist/entry.js"
    },
    "./db/*": {
      "types": "./dist/db/*.d.ts",
      "default": "./dist/db/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wrangler.toml",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@package-broker/core": "workspace:^",
    "@package-broker/db-sqlite": "workspace:^",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "miniflare": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/package-broker/broker.git",
    "directory": "packages/runtime-cloudflare"
  }
}
