{
  "name": "@package-broker/runtime-node",
  "version": "2.0.0-rc.3",
  "description": "Package Broker Node runtime",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "default": "./dist/entry.js"
    },
    "./db/*": {
      "types": "./dist/db/*.d.ts",
      "default": "./dist/db/*.js"
    },
    "./blob/s3": {
      "types": "./dist/blob/s3.d.ts",
      "default": "./dist/blob/s3.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/testing/**"
  ],
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@package-broker/core": "workspace:^",
    "@package-broker/db-sqlite": "workspace:^",
    "aws4fetch": "1.0.20",
    "better-sqlite3": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/package-broker/broker.git",
    "directory": "packages/runtime-node"
  }
}
