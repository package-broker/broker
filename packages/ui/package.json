{
  "name": "@package-broker/ui",
  "version": "2.0.0-rc.1",
  "description": "Package Broker static UI assets",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/manifest.json": "./dist/assets/manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b ../core && node scripts/build.mjs",
    "gen:api": "openapi-typescript ${PB_API_SPEC:-openapi.json} -o ${PB_API_TYPES:-src/api-types.ts}"
  },
  "peerDependencies": {
    "@package-broker/core": "workspace:^"
  },
  "devDependencies": {
    "@package-broker/core": "workspace:^",
    "@radix-ui/react-label": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@base-ui/react": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "esbuild": "catalog:",
    "openapi-typescript": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/package-broker/broker.git",
    "directory": "packages/ui"
  }
}
