{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": false,
  "signoff": "package-broker-release-bot[bot] <349232595+package-broker-release-bot[bot]@users.noreply.github.com>",
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "product",
      "components": [
        "core",
        "db-sqlite",
        "cli",
        "runtime-cloudflare",
        "runtime-node",
        "ui",
        "dist",
        "dist-cloudflare"
      ]
    }
  ],
  "packages": {
    "packages/core": {
      "component": "core",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/cli": {
      "component": "cli",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/runtime-cloudflare": {
      "component": "runtime-cloudflare",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/runtime-node": {
      "component": "runtime-node",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/ui": {
      "component": "ui",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/plugin-sso-oidc": {
      "component": "plugin-sso-oidc",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/plugin-github": {
      "component": "plugin-github",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/ui-assets": {
      "component": "ui-assets",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/db-sqlite": {
      "component": "db-sqlite",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/prebuilt": {
      "component": "dist",
      "prerelease": true,
      "prerelease-type": "rc"
    },
    "packages/prebuilt-cloudflare": {
      "component": "dist-cloudflare",
      "prerelease": true,
      "prerelease-type": "rc"
    }
  },
  "versioning": "prerelease",
  "prerelease-type": "rc",
  "prerelease": true
}
